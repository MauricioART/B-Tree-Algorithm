<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXSlider?>
<?import io.github.palexdev.materialfx.controls.MFXToggleButton?>
<?import io.github.palexdev.mfxcore.controls.Label?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="500.0" prefWidth="400.0"  xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arturoar.controller.SettingsDialogController">
   <children>
      <VBox alignment="CENTER" prefHeight="350.0" prefWidth="450.0">
         <children>
            <Label text="Settings" />
            <HBox alignment="CENTER" prefHeight="354.0" prefWidth="450.0">
               <children>
                  <Label text="B+ Tree parameter (m)" />
                  <Region HBox.hgrow="ALWAYS" />
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0">
                     <children>
                        <MFXSlider fx:id="mSlider" />
                        <Label fx:id="mLabel" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
            <HBox alignment="CENTER" prefHeight="354.0" prefWidth="450.0">
               <children>
                  <Label text="Traversal Animation" />
                  <Region HBox.hgrow="ALWAYS" />
                  <MFXToggleButton id="customToggleButton" fx:id="traversalToggle" contentDisposition="TOP" selected="true" styleClass="customToggleButton" textAlignment="CENTER" />
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
            <HBox alignment="CENTER" prefHeight="354.0" prefWidth="450.0">
               <children>
                  <Label text="Animation Speed" />
                  <Region HBox.hgrow="ALWAYS" />
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0">
                     <children>
                        <MFXSlider fx:id="speedSlider" />
                        <Label fx:id="speedLabel" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
            <HBox alignment="CENTER" prefHeight="354.0" prefWidth="450.0">
               <children>
                  <Label text="Light/Dark Mode" />
                  <Region HBox.hgrow="ALWAYS" />
                  <MFXToggleButton fx:id="themeToggle" contentDisposition="TOP" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <styleClass>
      <String fx:value="dialog" />
      <String fx:value="light" />
   </styleClass>
</StackPane>
