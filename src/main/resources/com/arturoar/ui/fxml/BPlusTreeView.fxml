<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="rootPane" prefWidth="1180" prefHeight="720" styleClass="terminal"
            stylesheets="@../css/theme.css" xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arturoar.controller.BPlusTreeController">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="13" styleClass="header">
                <StackPane styleClass="brand-mark">
                    <FontIcon iconLiteral="cil-sitemap" iconSize="20" />
                </StackPane>
                <VBox spacing="2">
                    <Label text="Explorador B+" styleClass="title" />
                    <Label text="Visualizador de árboles" styleClass="muted" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="treeInfoLabel" styleClass="accent" />
            </HBox>
            <HBox fx:id="toolbar" alignment="CENTER_LEFT" spacing="8" styleClass="toolbar">
                <ToggleButton fx:id="searchButton" text="Buscar" onAction="#showSearch" />
                <ToggleButton fx:id="insertButton" text="Insertar" onAction="#showInsert" />
                <ToggleButton fx:id="deleteButton" text="Borrar" onAction="#showDelete" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Centrar vista" onAction="#resetViewport" />
                <ToggleButton fx:id="settingsButton" text="Ajustes" onAction="#showSettings" />
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane styleClass="board">
            <Pane fx:id="canvas" />
            <VBox fx:id="emptyState" alignment="CENTER" spacing="8" mouseTransparent="true">
                <Label text="Árbol vacío" styleClass="empty-title" />
                <Label text="Inserta una clave para empezar" styleClass="muted" />
            </VBox>
        </StackPane>
    </center>
    <right>
        <VBox prefWidth="300" minWidth="260" spacing="16" styleClass="inspector">
            <VBox fx:id="operationPane" spacing="10">
                <Label text="Inspector" styleClass="panel-title" />
                <VBox spacing="4">
                    <Label text="Clave" styleClass="muted" />
                    <TextField fx:id="keyField" accessibleText="Clave" promptText="Ej. 24" onAction="#submitOperation" />
                </VBox>
                <VBox fx:id="valuePane" spacing="4">
                    <Label text="Valor" styleClass="muted" />
                    <TextField fx:id="valueField" accessibleText="Valor" promptText="Texto de la hoja" onAction="#submitOperation" />
                </VBox>
                <Button fx:id="submitButton" text="Buscar" onAction="#submitOperation" styleClass="primary" />
            </VBox>
            <VBox fx:id="resultPane" spacing="6" styleClass="result">
                <Label fx:id="resultTitle" text="Sin selección" wrapText="true" styleClass="result-title" />
                <Label fx:id="resultDetail" text="Busca una clave para consultar su valor." wrapText="true" styleClass="muted" />
            </VBox>
            <VBox fx:id="settingsPane" spacing="13">
                <Label text="Ajustes" styleClass="panel-title" />
                <VBox spacing="5">
                    <Label text="Orden del árbol" styleClass="muted" />
                    <ComboBox fx:id="orderChoice" accessibleText="Orden del árbol" onAction="#changeOrder" />
                </VBox>
                <VBox spacing="5">
                    <Label fx:id="speedLabel" styleClass="muted" />
                    <Slider fx:id="speedSlider" accessibleText="Velocidad de animación" min="0.5" max="1.5" value="1" />
                </VBox>
                <CheckBox fx:id="traversalToggle" text="Animar el recorrido" selected="true" />
                <CheckBox fx:id="soundToggle" text="Sonido" selected="true" />
                <CheckBox fx:id="lightThemeToggle" text="Tema claro" />
            </VBox>
        </VBox>
    </right>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="status-bar">
            <Label fx:id="keyCountLabel" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Rueda · zoom   /   Arrastre · mover" styleClass="muted" />
        </HBox>
    </bottom>
</BorderPane>
