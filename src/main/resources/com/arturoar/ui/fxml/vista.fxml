            </ToolBar>
            <Slider fx:id="speedSlider" layoutX="631.0" layoutY="23.0" />
            <Button fx:id="themeModeBtn" layoutX="23.0" layoutY="18.0" mnemonicParsing="false" text="Dia/Noche" />
            <Label layoutX="657.0" layoutY="10.0" text="AnimationSpeed" />
            <Label fx:id="speedLabel" layoutX="687.0" layoutY="43.0" text="Label" />
         </children>
         <cursor>
            <Cursor fx:constant="OPEN_HAND" />
         </cursor>
      </Pane>
   </children>
</AnchorPane>
