<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" fx:id="anchorPane" prefHeight="643.0" prefWidth="865.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arturoar.controller.BPlusTreeController">
   <children>
      <Label layoutX="289.0" layoutY="42.0" text="B Plus Tree Implementation" textAlignment="CENTER">
         <font>
            <Font name="Consolas" size="20.0" />
         </font>
      </Label>
      <Pane fx:id="canvas" layoutX="34.0" layoutY="95.0" prefHeight="510.0" prefWidth="796.0" style="-fx-background-color: white; -fx-background-radius: 13px; -fx-border-color: black;">
         <children>
            <ToolBar fx:id="toolbar" layoutX="543.0" layoutY="445.0" prefHeight="40.0" prefWidth="228.0" style="-fx-background-color: gray; -fx-opacity: 0.8; -fx-background-radius: 10px;">
              <items>
                <Button fx:id="homeBtn" mnemonicParsing="false" text="Home" textAlignment="CENTER">
                     <tooltip>
                        <Tooltip text="Empty Tooltip" />
                     </tooltip>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <Button fx:id="searchBtn" mnemonicParsing="false" text="Search">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <Button fx:id="insertBtn" mnemonicParsing="false" text="Add">
